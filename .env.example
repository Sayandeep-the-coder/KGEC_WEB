# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supavisor pooled connection string, port 6543)
DATABASE_URL=postgres://postgres.ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Storage S3 Access Keys
# Generate from: Supabase Dashboard → Settings → S3 Access Keys
SUPABASE_S3_ACCESS_KEY=your-s3-access-key
SUPABASE_S3_SECRET_KEY=your-s3-secret-key
SUPABASE_S3_REGION=us-east-1

# Upstash Redis (Rate limiting)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Rate Limiting Thresholds
RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
RATE_LIMIT_PUBLIC_WINDOW_SECS=60
RATE_LIMIT_ADMIN_MAX_REQUESTS=300
RATE_LIMIT_ADMIN_WINDOW_SECS=60
RATE_LIMIT_AUTH_BASE_DELAY_MS=1000
RATE_LIMIT_AUTH_MAX_DELAY_MS=3600000

# Gmail API (GCP OAuth2 — contact form notifications)
# 1. Create OAuth2 credentials in GCP Console (APIs & Services → Credentials)
# 2. Enable the Gmail API
# 3. Obtain a refresh token via OAuth2 Playground or a one-time consent script
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_SENDER_EMAIL=kgec.notifications@gmail.com
ADMIN_EMAIL=admin@kgec.ac.in
